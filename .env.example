# ============================================================
# ruoyi-all-next 数据库配置
# ============================================================
# 复制此文件为 .env.local 并修改配置

# === 数据库驱动 ===
# 支持: postgresql | mysql | mariadb | sqlserver | sqlite | tidb | oceanbase | opengauss | gaussdb | kingbase | dm | memory
# 不设置则自动从 DATABASE_URL 检测，无 URL 时 fallback 到 memory 模式
DB_DRIVER=postgresql

# === Prisma 使用的 provider（与 DB_DRIVER 对应） ===
# postgresql | mysql | sqlserver | sqlite
DB_PROVIDER=postgresql

# === 数据库连接 URL ===
# PostgreSQL:  postgresql://user:pass@localhost:5432/ruoyi?schema=public
# MySQL:       mysql://user:pass@localhost:3306/ruoyi
# MariaDB:     mysql://user:pass@localhost:3306/ruoyi
# SQL Server:  sqlserver://localhost:1433;database=ruoyi;user=sa;password=pass
# SQLite:      file:./dev.db
# TiDB:        mysql://user:pass@tidb-host:4000/ruoyi
# OceanBase:   mysql://user:pass@ob-host:2883/ruoyi
# openGauss:   postgresql://user:pass@opengauss-host:5432/ruoyi
# KingbaseES:  postgresql://user:pass@kingbase-host:54321/ruoyi
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ruoyi_next?schema=public

# === 连接池 ===
DB_POOL_SIZE=10
DB_TIMEZONE=UTC

# === 开发模式（不配置任何 DB 时自动启用内存存储） ===
# 设置为 memory 可强制使用内存模式
# DB_DRIVER=memory
