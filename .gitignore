# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.log
# testing
/coverage

# next.js
/.next/
/out/
/dist/domain-packs/

# production
/build
.next-ruoyi
# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example
tmp/**
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ============================================
# Flutter / Dart（apps/* 与 packages/*）
# ============================================

# Pub / 锁文件（应用提交，库不提交）
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/pubspec.lock
!apps/**/pubspec.lock

# Flutter 构建产物
**/.fvm/
**/coverage/
**/doc/api/
**/.history/
**/*.iml
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/flutter_export_environment.sh
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Pods/
**/ios/.symlinks/
**/ios/Runner.xcworkspace/xcuserdata/
**/ios/Runner.xcodeproj/xcuserdata/
**/ios/Runner.xcodeproj/project.xcworkspace/xcuserdata/
**/macos/Pods/
**/macos/Flutter/ephemeral/

# Android 构建产物 / 本地配置
**/android/.gradle/
**/android/captures/
**/android/gradlew
**/android/gradlew.bat
**/android/local.properties
**/android/**/GeneratedPluginRegistrant.java
**/android/key.properties
**/android/app/release/
**/android/app/debug/
**/android/app/profile/
**/android/app/.cxx/

# 签名密钥（严禁入库）
**/keystore/
**/*.jks
**/*.keystore
**/*.p12
**/*.p8
gen/**
# IDE
.idea/
*.iml
.vscode/launch.json

# Melos
**/.melos_tool/
melos_*.log

# Flutter test / 覆盖率
**/test/.test_coverage.dart
**/coverage/lcov.info

# 平台首个管理员初始化凭证（seed-prod 输出，含明文密码，严禁入库）
.platform-admin-credentials.txt
**/.platform-admin-credentials.txt

# 本地文件存储（infra LOCAL adapter）
.data/
# 用户上传 & TTS 临时语音文件（运行时生成，禁止入库）
public/uploads/
public/sounds/
public/dvr/

# 数据库自动备份（必须排除在 git 之外）
backups/
*.dump
backup_*.sql
db_backup_*.sql

ruoyi/**
apps/ruoyi-all-next/
apps/ruoyi