{
  "name": "ruoyi-all-next",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "quick-start": "node scripts/quick-start-runner.cjs",
    "quick-start:docker": "docker compose -f deploy/docker-compose.local.yml up --build",
    "quick-start:dev": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "db:up": "docker compose -f deploy/docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f deploy/docker-compose.dev.yml stop postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:bootstrap:sqlite": "tsx scripts/bootstrap-sqlite.ts",
    "db:backup": "node scripts/backup-db.cjs",
    "db:seed": "tsx scripts/seed-postgresql.ts",
    "db:init:sql": "tsx scripts/build-v1-init-sql.ts",
    "build:init-sql": "tsx scripts/build-v1-init-sql.ts",
    "sql:build": "tsx scripts/build-v1-init-sql.ts",
    "project:clone": "node scripts/clone-project-base.cjs",
    "project:create": "node scripts/clone-project-base.cjs",
    "catalog:sync:ruoyi": "node scripts/extract-seed-from-sql.cjs",
    "health-check": "bash ./scripts/health-check.sh",
    "admin:routes:manifest": "node scripts/generate-admin-route-manifest.cjs",
    "admin:routes:manifest:check": "node scripts/generate-admin-route-manifest.cjs --check",
    "admin:routes:check": "node scripts/check-admin-route-protection.cjs && node scripts/generate-admin-route-manifest.cjs --check",
    "contracts:audit-logs:check": "tsx scripts/check-audit-log-contracts.ts",
    "audit-logs:retention": "tsx scripts/run-audit-log-retention.ts",
    "init": "echo '[ruoyi-all-next] 本地最小启动无需基础设施初始化；如需接入仓库根初始化，请执行 npm run init:root'",
    "init:root": "node ./scripts/run-root-npm.cjs docker:dev:core && node ./scripts/run-root-npm.cjs db:init:force",
    "dev": "prisma generate && next dev -p 3200",
    "build": "prisma generate && next build",
    "start": "node .next-ruoyi/standalone/server.js",
    "lint": "next lint",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test:matrix": "vitest run test/unit test/integration",
    "test:e2e": "playwright test test/e2e",
    "test:agent": "playwright test test/agent",
    "test:all": "vitest run test/unit test/integration && playwright test",
    "domain:list": "node scripts/pack-domain.cjs --list",
    "domain:pack": "node scripts/pack-domain.cjs",
    "domain:manifests": "node scripts/write-domain-manifests.cjs",
    "domain:manifests:check": "node scripts/check-domain-manifests.cjs",
    "domain:contracts": "node scripts/write-domain-contracts.cjs",
    "domain:seams": "node scripts/write-seam-graph.cjs",
    "foundation:ontology": "node scripts/foundation-ontology.cjs",
    "foundation:ontology:check": "node scripts/foundation-ontology.cjs --check",
    "domain:check": "node scripts/check-domain-pack.cjs",
    "harness:check": "node scripts/check-harness-bundle.cjs",
    "contracts:sync": "npm run domain:contracts && npm run domain:manifests && npm run domain:seams",
    "skills:sync": "node scripts/sync-skills.cjs",
    "skills:check": "node scripts/sync-skills.cjs --check",
    "compat:check": "node scripts/check-compat-manifest.cjs",
    "standards:check": "node scripts/check-engineering-standards.cjs",
    "standards:baseline": "node scripts/check-engineering-standards.cjs --write-baseline",
    "evolution:backlog": "node scripts/build-evolution-backlog.cjs",
    "mcp:serve": "node scripts/mcp/ruoyi-mcp-server.cjs",
    "check": "npm run domain:manifests:check && npm run contracts:sync && npm run domain:check && npm run microservice:check && npm run harness:check && npm run admin:routes:check && npm run foundation:ontology:check && npm run skills:check && npm run compat:check && npm run standards:check && npm run agent:native:check && npm run agent:contracts:check && npm run evolution:backlog && node scripts/write-harness-trace.cjs",
    "domain:dev": "node scripts/pack-domain.cjs --dev --materialize",
    "domain:build": "node scripts/pack-domain.cjs --build --materialize",
    "domain:up": "node scripts/domain-up.cjs",
    "runtime:all": "node scripts/domain-up.cjs --all",
    "runtime:split": "node scripts/domain-up.cjs pay",
    "microservice:check": "node scripts/check-microservice-governance.cjs",
    "ruoyi:full:scan": "node ./scripts/run-root-tsx.cjs scripts/scan-ruoyi-full-capabilities.ts",
    "ruoyi:deep:scan": "node ./scripts/run-root-tsx.cjs scripts/scan-ruoyi-domain-evidence.ts",
    "ruoyi:mini:scan": "node ./scripts/run-root-tsx.cjs scripts/scan-yudao-boot-mini-core.ts",
    "ruoyi:starter:scan": "node ./scripts/run-root-tsx.cjs scripts/scan-all-next-starter-coverage.ts",
    "ruoyi:migration:board": "node ./scripts/run-root-tsx.cjs scripts/build-ruoyi-migration-board.ts",
    "ruoyi:p0:check": "node ./scripts/run-root-tsx.cjs scripts/check-ruoyi-p0.ts",
    "ruoyi:matrix:check": "node ./scripts/run-root-tsx.cjs scripts/check-ruoyi-capability-matrix.ts",
    "ruoyi:matrix:check:strict": "node ./scripts/run-root-tsx.cjs scripts/check-ruoyi-capability-matrix.ts --strict",
    "ruoyi:governance:check": "node ./scripts/run-root-tsx.cjs scripts/check-ruoyi-governance.ts",
    "ruoyi:governance:check:strict": "node ./scripts/run-root-tsx.cjs scripts/check-ruoyi-governance.ts --strict",
    "scaffold": "npx tsx ./scripts/scaffold-feature.ts",
    "tables:inventory": "node scripts/report-table-inventory.cjs",
    "tables:metadata-draft": "node scripts/draft-missing-table-metadata.cjs",
    "tables:migration": "tsx scripts/generate-table-migration.ts",
    "verify:real-db": "node scripts/verify-real-db.cjs",
    "postinstall": "prisma generate",
    "domains:capabilities": "node scripts/scan-domain-capabilities.cjs",
    "domains:parity": "node scripts/scan-source-parity.cjs",
    "domain:new": "tsx scripts/create-business-domain.ts",
    "agent:contracts": "node scripts/agent/collect-contracts.cjs",
    "agent:contracts:check": "node scripts/agent/collect-contracts.cjs --check",
    "agent:ops": "node scripts/agent/run-ops.cjs",
    "agent:ops:health": "node scripts/agent/run-ops.cjs health",
    "agent:native:check": "node scripts/check-agent-native.cjs",
    "agent:native:audit": "node scripts/check-agent-native.cjs --audit",
    "agent:native:baseline": "node scripts/check-agent-native.cjs --update-baseline"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@puckeditor/core": "0.23.0",
    "better-sqlite3": "^12.11.1",
    "crypto-js": "^4.2.0",
    "fflate": "^0.8.2",
    "kysely": "^0.29.4",
    "mysql2": "^3.11.5",
    "next": "^16.3.6",
    "node-sql-parser": "5.4.0",
    "pg": "^8.13.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.4",
    "postcss": "^8.5.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@12.4.2"
}
