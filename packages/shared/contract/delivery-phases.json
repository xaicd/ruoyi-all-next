{
  "$schema": "ruoyi.delivery.phases/v1",
  "note": "AI-Driven 全环节交付清单：每个阶段的产物、启用的 Skill、以及该阶段的门禁命令。由 scripts/check-delivery.cjs 校验实际产物；经 MCP 暴露给 agent 查询『还缺什么』。",
  "phases": [
    {
      "id": "requirement", "name": "需求",
      "artifacts": ["docs/features/**/requirements.md", "docs/features/**/sprint-prod/*.md"],
      "skill": "product-requirements",
      "gate": "npm run standards:check",
      "outputsUserSees": "需求文档（可追溯的单向推导链起点）"
    },
    {
      "id": "prototype", "name": "原型设计",
      "artifacts": ["docs/features/**/prototype*", "docs/features/**/design.md"],
      "skill": "product-requirements",
      "gate": "npm run ui-framework:check"
    },
    {
      "id": "ui-design", "name": "UI 设计",
      "artifacts": ["docs/features/**/design.md"],
      "skill": "ui-design",
      "gate": "npm run standards:check"
    },
    {
      "id": "architecture", "name": "架构设计",
      "artifacts": ["docs/features/**/design.md", "docs/architecture/artifacts/harness-trace-latest.json"],
      "skill": "architecture-design",
      "gate": "npm run microservice:check"
    },
    {
      "id": "development", "name": "开发",
      "artifacts": ["docs/features/**/tasks.md", "packages/plugins/**", "src/app/api/v1/**"],
      "skill": "new-business-plugin",
      "gate": "npm run check"
    },
    {
      "id": "testing", "name": "测试",
      "artifacts": ["docs/agent/contracts.json", "test/e2e/**", "**/__tests__/**"],
      "skill": "automated-testing",
      "gate": "npm run verify:real-db"
    },
    {
      "id": "ops", "name": "运维",
      "artifacts": ["deploy/**", "Dockerfile", "docs/skills/**/devops*"],
      "skill": "devops",
      "gate": "npm run build"
    },
    {
      "id": "operations", "name": "运营",
      "artifacts": ["docs/agent/contracts.json", "scripts/agent/run-ops.cjs"],
      "skill": "new-business-plugin",
      "gate": "npm run agent:ops:health"
    },
    {
      "id": "implementation", "name": "实施",
      "artifacts": ["docs/features/**/tasks.md", "docs/features/sprint-prod/*.md"],
      "skill": "product-requirements",
      "gate": "npm run check"
    }
  ]
}
