  "displayName": "aigw",
  "description": "aigw 域（由 scripts/scaffold-domain-plugin.cjs 生成的第一方插件声明）",
  "author": "RuoYi All Next",
  "categories": [
    "automation"
  ],
  "capabilities": [
    "api.routes.register"
