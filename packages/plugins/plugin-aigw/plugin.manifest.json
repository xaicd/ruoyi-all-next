  "entrypoints": {
    "merged": "./plugin-entry.ts"
  },
  "domain": {
    "kind": "business",
    "stage": "B",
    "contractVersion": "v1",
    "publicPrefixes": [
      "/api/v1/admin/aigw",
      "/api/v1/open/aigw"
    ],
    "upstreamEnv": "RUOYI_DOMAIN_AIGW_UPSTREAM",
    "defaultPort": 3226,
    "packable": true,
    "independentDatabase": false,
    "dependsOnModules": [
      "shared"
    ],
    "auth": {
      "audience": "admin",
      "tenantPolicy": "required"
    },
    "resilience": {
      "timeoutMs": 15000,
      "retryMaxAttempts": 1,
      "safeMethodsOnly": true,
      "idempotencyRequired": true
    }
  },
