{
  "$schema": "ruoyi-plugin-manifest/v1",
  "domain": "mes",
  "id": "ruoyi.mes",
  "apiVersion": 1,
  "displayName": "制造中心",
  "kind": "business",
  "stage": "B",
  "owner": "mes",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "src/modules/mes/contract/mes.facade.ts"
    ],
    "proto": "src/modules/mes/contract/mes.proto",
    "actions": "src/modules/mes/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/mes"
    ],
    "adminPrefix": "/api/v1/admin/mes"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "ruoyi.mes",
    "commandSubject": "ruoyi.cmd.mes.>",
    "eventSubject": "ruoyi.evt.mes.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "RUOYI_DOMAIN_MES_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3222
  },
  "resilience": {
    "timeoutMs": 8000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listWorkOrders",
    "reportWork"
  ],
  "rpc": [
    {
      "service": "MesService",
      "method": "Ping"
    },
    {
      "service": "MesService",
      "method": "ListWorkOrders"
    },
    {
      "service": "MesService",
      "method": "ReportWork"
    }
  ],
  "actions": [
    "mes.ping",
    "mes.listWorkOrders",
    "mes.reportWork"
  ],
  "permissions": [
    "mes:work-order:report",
    "mes:work-order:view"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
