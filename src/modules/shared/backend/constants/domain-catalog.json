{
  "version": 1,
  "description": "Native domain pack/run/deploy catalog. Source of truth for route manifests, BFF upstream switching, and domain images.",
  "layers": {
    "foundation": {
      "modules": ["shared"],
      "deployable": false,
      "invoke": "sdk",
      "description": "Runtime SDK packed into every process. Never a microservice, never RPC."
    },
    "platform": {
      "domains": ["system", "infra"],
      "deployable": true,
      "defaultColocateWith": "bff",
      "publicRpc": "system: getDictDataByType + getPermissionInfoByUser; infra: none"
    },
    "business": {
      "domains": ["online", "bpm", "pay", "report", "mp", "mall", "member", "crm", "erp", "wms", "mes", "ai", "iot", "im"],
      "deployable": true
    }
  },
  "rpc": {
    "local": {
      "mode": "sdk",
      "protocol": "in-process",
      "serialization": "none",
      "facadeRequired": true
    },
    "remote": {
      "mode": "rpc",
      "protocol": "nats-rr",
      "serialization": "json",
      "facadeRequired": true,
      "httpPath": "/api/internal/rpc"
    },
    "stageC": {
      "protocol": "grpc",
      "serialization": "protobuf"
    },
    "rejected": ["dubbo", "thrift", "hessian", "moleculer", "nestjs"]
  },
  "messaging": {
    "protocolVersion": "v1",
    "defaultTransport": "in-process",
    "commandSubjectPrefix": "ruoyi.cmd",
    "eventSubjectPrefix": "ruoyi.evt",
    "headerKeys": {
      "contractVersion": "x-contract-version",
      "traceId": "x-trace-id",
      "tenantId": "x-tenant-id",
      "actorId": "x-actor-id",
      "idempotencyKey": "x-idempotency-key",
      "sourceDomain": "x-source-domain"
    }
  },
  "domains": [
    {
      "name": "system",
      "owner": "system",
      "kind": "platform",
      "stage": "A",
      "contractVersion": "v1",
      "publicPrefixes": ["/api/v1/admin/system"],
      "implementation": "local-ts",
      "upstreamEnv": "RUOYI_DOMAIN_SYSTEM_UPSTREAM",
      "defaultPort": 3210,
      "packable": true,
      "packKind": "api-only",
      "dependsOnModules": ["shared"],
      "independentDatabase": false,
      "auth": { "audience": "admin", "tenantPolicy": "required" },
      "resilience": { "timeoutMs": 5000, "retryMaxAttempts": 1, "safeMethodsOnly": true, "idempotencyRequired": false }
    },
    {
      "name": "infra",
      "owner": "infra",
      "kind": "platform",
      "stage": "A",
      "contractVersion": "v1",
      "publicPrefixes": ["/api/v1/admin/infra"],
      "implementation": "local-ts",
      "upstreamEnv": "RUOYI_DOMAIN_INFRA_UPSTREAM",
      "defaultPort": 3211,
      "packable": true,
      "packKind": "api-only",
      "dependsOnModules": ["shared"],
      "independentDatabase": false,
      "auth": { "audience": "admin", "tenantPolicy": "required" },
