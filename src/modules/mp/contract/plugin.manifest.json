{
  "$schema": "ruoyi-plugin-manifest/v1",
  "domain": "mp",
  "id": "ruoyi.mp",
  "apiVersion": 1,
  "displayName": "微信公号",
  "kind": "business",
  "stage": "B",
  "owner": "mp",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "src/modules/mp/contract/mp.facade.ts"
    ],
    "proto": "src/modules/mp/contract/mp.proto",
    "actions": "src/modules/mp/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/mp"
    ],
    "adminPrefix": "/api/v1/admin/mp"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "ruoyi.mp",
    "commandSubject": "ruoyi.cmd.mp.>",
    "eventSubject": "ruoyi.evt.mp.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "RUOYI_DOMAIN_MP_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3216
  },
  "resilience": {
    "timeoutMs": 8000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listAccounts",
    "listFans",
    "sendMessage"
  ],
  "rpc": [
    {
      "service": "MpService",
      "method": "Ping"
    },
    {
      "service": "MpService",
      "method": "ListAccounts"
    },
    {
      "service": "MpService",
      "method": "ListFans"
    },
    {
      "service": "MpService",
      "method": "SendMessage"
    }
  ],
  "actions": [
    "mp.ping",
    "mp.listAccounts",
    "mp.listFans",
    "mp.sendMessage"
  ],
  "permissions": [
    "mp:account:view",
    "mp:fan:view",
    "mp:message:send"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
