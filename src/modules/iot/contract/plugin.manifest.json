{
  "$schema": "ruoyi-plugin-manifest/v1",
  "id": "ruoyi.iot",
  "apiVersion": 1,
  "displayName": "物联中台",
  "kind": "business",
  "stage": "B",
  "owner": "iot",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "src/modules/iot/contract/iot.facade.ts"
    ],
    "proto": "src/modules/iot/contract/iot.proto",
    "actions": "src/modules/iot/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/iot"
    ],
    "adminPrefix": "/api/v1/admin/iot"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "ruoyi.iot",
    "commandSubject": "ruoyi.cmd.iot.>",
    "eventSubject": "ruoyi.evt.iot.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "RUOYI_DOMAIN_IOT_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3224
  },
  "resilience": {
    "timeoutMs": 5000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listDevices",
    "createDevice",
    "listAlerts",
    "handleAlert"
  ],
  "rpc": [
    {
      "service": "IotService",
      "method": "Ping"
    },
    {
      "service": "IotService",
      "method": "ListDevices"
    },
    {
      "service": "IotService",
      "method": "CreateDevice"
    },
    {
      "service": "IotService",
      "method": "ListAlerts"
    },
    {
      "service": "IotService",
      "method": "HandleAlert"
    }
  ],
  "actions": [
    "iot.ping",
    "iot.listDevices",
    "iot.createDevice",
    "iot.listAlerts",
    "iot.handleAlert"
  ],
  "permissions": [
    "iot:alert:view",
    "iot:device:view"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
