{
  "$schema": "ruoyi-module-manifest/v1",
  "domain": "mall",
  "id": "ruoyi.mall",
  "apiVersion": 1,
  "displayName": "mall",
  "kind": "business",
  "stage": "B",
  "owner": "mall",
  "contractVersion": "v1",
  "implementation": "local-ts",
  "minimumHostVersion": "1.0.0",
  "capabilities": [
    "api.routes.register",
    "facade.invoke",
    "rpc.serve",
    "cmd.dispatch",
    "pack.independent"
  ],
  "entrypoints": {
    "facade": [
      "src/modules/mall/contract/mall.facade.ts"
    ],
    "proto": "src/modules/mall/contract/mall.proto",
    "actions": "src/modules/mall/contract/actions.ts"
  },
  "apiRoutes": {
    "publicPrefix": [
      "/api/v1/admin/mall",
      "/api/v1/app/mall"
    ],
    "adminPrefix": "/api/v1/admin/mall"
  },
  "auth": {
    "audience": "admin",
    "tenantPolicy": "required"
  },
  "messaging": {
    "queueGroup": "ruoyi.mall",
    "commandSubject": "ruoyi.cmd.mall.>",
    "eventSubject": "ruoyi.evt.mall.>"
  },
  "invoke": {
    "colocated": "sdk",
    "remote": "rpc",
    "protocol": "nats-rr",
    "serialization": "json"
  },
  "upstream": {
    "env": "RUOYI_DOMAIN_MALL_UPSTREAM",
    "protocol": "http",
    "defaultPort": 3217
  },
  "resilience": {
    "timeoutMs": 5000,
    "retry": {
      "maxAttempts": 1,
      "safeMethodsOnly": true
    },
    "idempotencyRequired": true
  },
  "facadeMethods": [
    "ping",
    "listProducts",
    "listOrders",
    "issueCoupon"
  ],
  "rpc": [
    {
      "service": "MallService",
      "method": "Ping"
    },
    {
      "service": "MallService",
      "method": "ListProducts"
    },
    {
      "service": "MallService",
      "method": "ListOrders"
    },
    {
      "service": "MallService",
      "method": "IssueCoupon"
    }
  ],
  "actions": [
    "mall.ping",
    "mall.listProducts",
    "mall.listOrders",
    "mall.issueCoupon"
  ],
  "permissions": [
    "mall:coupon:issue",
    "mall:order:view",
    "mall:product:view"
  ],
  "dependsOn": [
    "shared"
  ],
  "pack": {
    "enabled": true,
    "kind": "api-only",
    "independentDatabase": false
  }
}
